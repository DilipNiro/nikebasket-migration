# Copier ce fichier en .env et remplir les valeurs
# Ne jamais commiter le fichier .env (ajouté dans .gitignore)

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=ecommerce

# JWT
JWT_SECRET=changez_ce_secret_en_production_minimum_32_chars
JWT_EXPIRES_IN=24h

# Serveur
PORT=3001
NODE_ENV=development

# Frontend (CORS)
FRONTEND_URL=http://localhost:5173

# Email (Nodemailer) — laisser vide en développement pour recevoir les liens dans la réponse JSON
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@nikebasket.fr
SMTP_PASS=votre_mot_de_passe_smtp
SMTP_FROM=no-reply@nikebasket.fr

# Stripe — laisser vide pour utiliser le paiement simulé
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudinary — laisser vide pour stocker les images en local (/uploads)
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret
